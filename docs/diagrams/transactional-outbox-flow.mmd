sequenceDiagram
    autonumber
    actor Client
    participant Service as Business Domain Service
    participant DB as PostgreSQL Database
    participant OutboxService as OutboxServiceImpl
    participant Scheduler as OutboxScheduler
    participant Publisher as OutboxPublisherServiceImpl
    participant Kafka as Apache Kafka Broker

    Client->>Service: Execute Money Transfer / Payment Collect
    
    rect rgb(240, 255, 240)
        note over Service, OutboxService: Single Atomic Database Transaction (@Transactional)
        Service->>DB: Mutate Financial Balances (UPDATE bank_accounts)
        Service->>DB: Record Transaction History (INSERT INTO transactions)
        Service->>OutboxService: saveOutboxEvent(eventId, aggregateType, payload)
        OutboxService->>DB: INSERT INTO outbox_events (Status: PENDING)
        DB-->>Service: Transaction Committed
    end

    Service-->>Client: HTTP 200 OK Response Returned

    loop Every 5 Seconds (Cron Poll)
        Scheduler->>DB: SELECT * FROM outbox_events WHERE status = 'PENDING' LIMIT 50
        DB-->>Scheduler: Return List of Pending Outbox Events
        
        loop For Each Pending Event
            Scheduler->>Publisher: publishEvent(outboxEvent)
            Publisher->>Kafka: KafkaTemplate.send(topic, eventId, payload)
            Kafka-->>Publisher: ProducerRecord Acknowledgment (ACK)
            Publisher->>DB: UPDATE outbox_events SET status = 'PROCESSED', processed_at = NOW()
        end
    end
