{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Application Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "none" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "statDetails": {}, "text": {} },
      "targets": [{ "expr": "up{job=\"upi-payment-simulator\"}", "legendFormat": "App Status" }],
      "title": "Application Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "process_uptime_seconds{application=\"upi-payment-simulator\"}", "legendFormat": "Uptime" }],
      "title": "JVM Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "jvm_threads_live_threads{application=\"upi-payment-simulator\"}", "legendFormat": "Live Threads" }],
      "title": "Active Threads",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }, "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 5,
      "targets": [
        { "expr": "system_cpu_usage{application=\"upi-payment-simulator\"}", "legendFormat": "System CPU" },
        { "expr": "process_cpu_usage{application=\"upi-payment-simulator\"}", "legendFormat": "Process CPU" }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "bytes" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 6,
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\",application=\"upi-payment-simulator\"}", "legendFormat": "Heap Used" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\",application=\"upi-payment-simulator\"}", "legendFormat": "Heap Max" }
      ],
      "title": "Heap Usage",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 7,
      "title": "API Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "reqps" } },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 6 },
      "id": 8,
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"upi-payment-simulator\"}[1m]))", "legendFormat": "Total RPS" }],
      "title": "HTTP Requests/sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" } },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 6 },
      "id": 9,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"upi-payment-simulator\"}[1m])) by (le))", "legendFormat": "P95 Latency" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"upi-payment-simulator\"}[1m])) by (le))", "legendFormat": "P99 Latency" }
      ],
      "title": "API Response Latencies (P95 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 6 },
      "id": 10,
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"upi-payment-simulator\"}[1m])) by (status)", "legendFormat": "HTTP {{status}}" }],
      "title": "HTTP Status Codes Distribution",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 11,
      "title": "Business Metrics & KPI",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" } },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 12 },
      "id": 12,
      "targets": [
        { "expr": "rate(transaction_success_total[1m])", "legendFormat": "Txn Success/sec" },
        { "expr": "rate(transaction_failure_total[1m])", "legendFormat": "Txn Failure/sec" }
      ],
      "title": "Transactions/sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyINR" } },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 12 },
      "id": 13,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "transaction_total_amount_sum", "legendFormat": "Total Volume (INR)" }],
      "title": "Total Transaction Amount",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 12 },
      "id": 14,
      "targets": [
        { "expr": "paymentrequest_created_total", "legendFormat": "Created" },
        { "expr": "paymentrequest_accepted_total", "legendFormat": "Accepted" },
        { "expr": "paymentrequest_rejected_total", "legendFormat": "Rejected" },
        { "expr": "paymentrequest_cancelled_total", "legendFormat": "Cancelled" }
      ],
      "title": "Payment Requests Lifecycle",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 12 },
      "id": 15,
      "targets": [
        { "expr": "otp_generated_total", "legendFormat": "OTP Generated" },
        { "expr": "otp_verified_total", "legendFormat": "OTP Verified" },
        { "expr": "otp_failed_total", "legendFormat": "OTP Failed" },
        { "expr": "ratelimit_blocked_total", "legendFormat": "Rate Limit Blocked" },
        { "expr": "authentication_failure_total", "legendFormat": "Auth Failures" }
      ],
      "title": "Security & OTP Telemetry",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 16,
      "title": "Kafka & Distributed Outbox",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" } },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 18 },
      "id": 17,
      "targets": [
        { "expr": "rate(kafka_event_sent_total[1m])", "legendFormat": "Events Sent/sec" },
        { "expr": "rate(kafka_event_failed_total[1m])", "legendFormat": "Events Failed/sec" }
      ],
      "title": "Kafka Producer Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 18 },
      "id": 18,
      "targets": [
        { "expr": "outbox_created_total", "legendFormat": "Created Outbox" },
        { "expr": "outbox_published_total", "legendFormat": "Published Outbox" },
        { "expr": "outbox_failed_total", "legendFormat": "Failed Outbox" }
      ],
      "title": "Outbox Events Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 18 },
      "id": 19,
      "targets": [
        { "expr": "redis_cache_hit_total", "legendFormat": "Cache Hit" },
        { "expr": "redis_cache_miss_total", "legendFormat": "Cache Miss" },
        { "expr": "redis_lock_acquired_total", "legendFormat": "Lock Acquired" },
        { "expr": "redis_lock_failed_total", "legendFormat": "Lock Failed" }
      ],
      "title": "Redis Cache & Distributed Locks",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 20,
      "title": "Database Connection Pool (HikariCP)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" } },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 24 },
      "id": 21,
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"upi-payment-simulator\"}", "legendFormat": "Active Connections" },
        { "expr": "hikaricp_connections_idle{application=\"upi-payment-simulator\"}", "legendFormat": "Idle Connections" }
      ],
      "title": "Hikari Connection Pool Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" } },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 24 },
      "id": 22,
      "targets": [{ "expr": "hikaricp_connections_acquire_seconds_sum{application=\"upi-payment-simulator\"}", "legendFormat": "Acquire Wait Time" }],
      "title": "Connection Wait Time",
